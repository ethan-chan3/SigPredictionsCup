# Copy to .env and fill in. Never commit .env.
# Generate at Settings -> API Keys; the `read` scope is sufficient for this client.
PREDICTIONS_CUP_API_KEY= 
# Optional. Defaults to https://sig.thesuper.market/api/v1
PREDICTIONS_CUP_BASE_URL=
# Optional. Tournament to scope venue reads to (e.g. midterm-elections).
PREDICTIONS_CUP_TOURNAMENT_SLUG=

# Optional risk limits, in tournament currency (defaults shown).
RISK_MAX_POSITION_SIZE=1000
RISK_MAX_TOTAL_EXPOSURE=10000
RISK_DAILY_LOSS_LIMIT=500
RISK_MAX_OPEN_ORDERS=50
